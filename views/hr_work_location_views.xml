<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_work_location_geofence_form" model="ir.ui.view">
        <field name="name">hr.work.location.geofence.form</field>
        <field name="model">hr.work.location</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Work Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Head Office"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Work Location">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="location_type"/>
                            <field name="address_id" string="Address"/>
                        </group>
                        <group string="Geofence">
                            <field name="use_geofence" widget="boolean_toggle"/>
                            <field name="geofence_latitude"
                                   invisible="not use_geofence"
                                   required="use_geofence"/>
                            <field name="geofence_longitude"
                                   invisible="not use_geofence"
                                   required="use_geofence"/>
                            <field name="geofence_radius"
                                   invisible="not use_geofence"
                                   required="use_geofence"/>
                            <field name="geofence_input_mode"
                                   widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="not use_geofence"/>
                        </group>
                    </group>
                    <group invisible="not use_geofence or geofence_input_mode != 'map'">
                        <field name="geofence_input_mode"
                               nolabel="1"
                               colspan="2"
                               widget="geofence_map"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_work_location_geofence_list" model="ir.ui.view">
        <field name="name">hr.work.location.geofence.list</field>
        <field name="model">hr.work.location</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list string="Work Locations">
                <field name="name"/>
                <field name="location_type"/>
                <field name="address_id"/>
                <field name="use_geofence" widget="boolean_toggle"/>
                <field name="geofence_radius" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_hr_work_location_geofence" model="ir.actions.act_window">
        <field name="name">Geofence Locations</field>
        <field name="res_model">hr.work.location</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_work_location_geofence_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_work_location_geofence_form')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define work locations and their geofence boundaries.
            </p>
            <p>
                Enable the geofence on a location and provide its coordinates
                and radius.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_work_location_geofence"
              name="Geofence Locations"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_hr_work_location_geofence"
              sequence="50"
              groups="hr.group_hr_manager"/>

</odoo>
