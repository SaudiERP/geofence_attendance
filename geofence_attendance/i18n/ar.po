#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_employee.py:0
msgid ""
"Location access is required to register attendance. Please enable location "
"services in your browser and try again."
msgstr ""
"يتطلّب تسجيل الحضور الوصول إلى الموقع الجغرافي. يرجى تفعيل خدمات الموقع "
"في المتصفح والمحاولة مرة أخرى."

#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_employee.py:0
msgid "Invalid location data received from the device."
msgstr "بيانات الموقع المستلمة من الجهاز غير صحيحة."

#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_employee.py:0
msgid ""
"You are outside the allowed attendance area for '%(loc)s'.\n"
"Your distance: %(dist).0f m\n"
"Allowed radius: %(rad).0f m"
msgstr ""
"أنت خارج منطقة الحضور المسموح بها للمكان '%(loc)s'.\n"
"المسافة الحالية: %(dist).0f متر\n"
"النطاق المسموح: %(rad).0f متر"

#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_work_location.py:0
msgid "Latitude must be between -90 and 90."
msgstr "يجب أن يكون خط العرض بين -90 و 90."

#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_work_location.py:0
msgid "Longitude must be between -180 and 180."
msgstr "يجب أن يكون خط الطول بين -180 و 180."

#. module: geofence_attendance
#. odoo-python
#: code:addons/geofence_attendance/models/hr_work_location.py:0
msgid "Allowed radius must be greater than zero."
msgstr "يجب أن يكون النطاق المسموح أكبر من صفر."

